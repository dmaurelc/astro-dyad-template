---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { formatDate } from "../lib/utils";

const today = formatDate(new Date());

const features = [
  {
    n: "01",
    title: "Content collections",
    body: "Validate Markdown, MDX, and JSON with type-safe Zod schemas. Stop hand-rolling frontmatter parsing.",
  },
  {
    n: "02",
    title: "Server islands",
    body: "Defer dynamic blocks to dedicated endpoints. Hydrate only what needs to be interactive.",
  },
  {
    n: "03",
    title: "View transitions",
    body: "Native browser API for cross-page animations. Zero JS for static navigation, instant SPA feel.",
  },
  {
    n: "04",
    title: "Tailwind v4",
    body: "Lightning-fast CSS-first config, no PostCSS plugin dance, design tokens via @theme.",
  },
];

const stats = [
  { k: "0kb", v: "shipped JS by default" },
  { k: "100", v: "Lighthouse (template)" },
  { k: "6", v: "demo pages in this build" },
];
---

<Layout
  title="Astro Template — Editorial edition"
  description="An editorial Astro 7 starter with Tailwind v4, dark mode, content collections, and view transitions — ready to ship to Netlify."
  image="/og-default.png"
>
  <Header />

  <main id="main" class="mx-auto max-w-6xl px-6 pb-24 pt-16 sm:px-8 sm:pt-24">
    {/* ─── Hero ─────────────────────────────────────────── */}
    <section class="rise grid gap-10 pb-20 sm:grid-cols-12 sm:gap-12 sm:pb-28">
      <div class="sm:col-span-7">
        <p class="eyebrow">Issue 01 — {today}</p>
        <h1
          class="mt-6 font-display text-[clamp(2.5rem,7vw,5.5rem)] leading-[0.95] tracking-[-0.035em] text-foreground"
        >
          A quiet framework<br />
          for <em class="text-accent not-italic">loud</em> ideas.
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-muted-foreground">
          Astro ships zero JavaScript by default. Pages render to static HTML
          and selectively hydrate only the islands that need it. This template
          demonstrates that discipline with an editorial layout, dark mode, and
          six demo routes.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 rounded-full bg-foreground px-5 py-2.5 text-sm font-medium text-background transition-opacity hover:opacity-90"
          >
            Read the journal
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/playground"
            class="inline-flex items-center gap-2 rounded-full border border-border bg-background px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-secondary"
          >
            Try the playground
          </a>
        </div>
      </div>

      <aside class="sm:col-span-5 sm:pt-12">
        <div class="border-l border-border pl-6">
          <p class="eyebrow">Stats</p>
          <dl class="mt-6 space-y-5">
            {
              stats.map((s) => (
                <div class="flex items-baseline justify-between gap-4 border-b border-border pb-3 last:border-b-0">
                  <dt class="font-display text-4xl tracking-tight">{s.k}</dt>
                  <dd class="text-right text-sm text-muted-foreground">{s.v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </section>

    {/* ─── Features — 2-col zig-zag, breaks the 3-card row ─────── */}
    <section class="rise border-t border-border pt-16">
      <div class="mb-12 flex items-baseline justify-between gap-6">
        <h2 class="font-display text-3xl tracking-tight">
          What you get, in four pieces.
        </h2>
        <p class="hidden text-sm text-muted-foreground sm:block">
          Each feature is its own demo page.
        </p>
      </div>

      <div class="grid gap-x-10 gap-y-12 sm:grid-cols-2">
        {
          features.map((f) => (
            <article class="group">
              <p class="font-mono text-xs tracking-widest text-muted-foreground">
                {f.n}
              </p>
              <h3 class="mt-3 font-display text-2xl tracking-tight transition-colors group-hover:text-accent">
                {f.title}
              </h3>
              <p class="mt-3 max-w-md text-[15px] leading-relaxed text-muted-foreground">
                {f.body}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    {/* ─── Pull-quote / CTA strip ───────────────────────────── */}
    <section class="mt-24 rounded-2xl border border-border bg-secondary/50 p-10 sm:p-14">
      <p class="font-display text-2xl leading-snug tracking-tight sm:text-3xl">
        “The web is a magazine. Astro is the layout grid. Everything else is
        typesetting.”
      </p>
      <p class="mt-6 font-mono text-xs uppercase tracking-widest text-muted-foreground">
        — Template author's note
      </p>
    </section>
  </main>

  <Footer />
</Layout>