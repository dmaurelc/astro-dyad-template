---
/**
 * Renders a single JSON-LD <script> tag.
 * Uses set:html so the payload is injected verbatim — JSON.stringify
 * guarantees no script breakout. Never concatenate user strings manually.
 */
interface Props {
  data: Record<string, unknown>;
}

const { data } = Astro.props;
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(data)}
></script>