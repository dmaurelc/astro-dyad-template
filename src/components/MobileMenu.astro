---
/**
 * MobileMenu — off-canvas hamburger menu for screens < md.
 *
 * Usage:
 *   <MobileMenu />
 *
 * Renders:
 *   1. A hamburger trigger button (visible < md) wired to the panel via aria-controls
 *   2. A fixed off-canvas panel containing primary nav + theme toggle + close button
 *
 * Behavior (in mobile-menu.ts):
 *   - Click hamburger → panel slides in from right, body scroll locked, focus trapped
 *   - ESC key → closes, returns focus to the hamburger
 *   - Click scrim → closes
 *   - View transitions: re-bound automatically
 */

export interface Props {
  /** Optional panel id; defaults to "mobile-menu". Required if multiple menus per page. */
  id?: string;
}

const { id = "mobile-menu" } = Astro.props;
const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Index", description: "Editorial homepage" },
  { href: "/about", label: "About", description: "Colophon + principles" },
  { href: "/blog", label: "Journal", description: "Long-form notes" },
  { href: "/components", label: "Components", description: "Design system" },
  { href: "/playground", label: "Playground", description: "Interactive island" },
];

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

{/* Hamburger trigger — visible < md, hidden >= md */}
<button
  type="button"
  data-menu-toggle
  aria-controls={id}
  aria-expanded="false"
  aria-label="Open navigation menu"
  class="mobile-menu-trigger inline-flex h-9 w-9 items-center justify-center rounded-full border border-border bg-background text-foreground transition-colors hover:bg-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring md:hidden"
>
  <svg
    class="h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <line x1="4" y1="7" x2="20" y2="7"></line>
    <line x1="4" y1="12" x2="20" y2="12"></line>
    <line x1="4" y1="17" x2="20" y2="17"></line>
  </svg>
</button>

{/* Off-canvas panel — fixed, full-height, slides from right */}
<div
  id={id}
  data-menu-panel
  data-open="false"
  aria-hidden="true"
  aria-label="Mobile navigation"
  role="dialog"
  class="mobile-menu-panel fixed inset-0 z-40 md:hidden"
>
  {/* Scrim — click to dismiss */}
  <div
    data-menu-scrim
    class="absolute inset-0 bg-foreground/30 backdrop-blur-sm"
  ></div>

  {/* Sheet */}
  <aside
    class="mobile-menu-sheet absolute right-0 top-0 flex h-dvh w-[min(360px,85vw)] flex-col border-l border-border bg-background shadow-2xl"
  >
    <div class="flex items-center justify-between border-b border-border px-6 py-5">
      <p class="font-display text-lg tracking-tight">
        Menu<span class="text-accent">.</span>
      </p>
      <button
        type="button"
        data-menu-close
        aria-label="Close navigation menu"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border bg-background text-foreground transition-colors hover:bg-secondary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="6" y1="6" x2="18" y2="18"></line>
          <line x1="18" y1="6" x2="6" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav aria-label="Primary mobile" class="flex-1 overflow-y-auto px-3 py-6">
      <ul class="space-y-1">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "block rounded-lg px-3 py-3 transition-colors",
                  isActive(link.href)
                    ? "bg-secondary text-foreground"
                    : "text-foreground hover:bg-secondary",
                ]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                <span class="block font-display text-lg tracking-tight">
                  {link.label}
                </span>
                <span class="mt-0.5 block text-xs text-muted-foreground">
                  {link.description}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="border-t border-border px-6 py-4">
      <p class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
        Press ESC to close
      </p>
    </div>
  </aside>
</div>

<style>
  /* CSS-driven open/closed states — keeps the island logic free of styles.
     Without JS these states are inert; JS toggles data-open and the
     CSS transitions handle the animation. */
  .mobile-menu-panel[data-open="false"] [data-menu-scrim] {
    opacity: 0;
    pointer-events: none;
  }
  .mobile-menu-panel[data-open="true"] [data-menu-scrim] {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-menu-panel[data-open="false"] .mobile-menu-sheet {
    transform: translateX(100%);
  }
  .mobile-menu-panel[data-open="true"] .mobile-menu-sheet {
    transform: translateX(0);
  }

  .mobile-menu-scrim,
  .mobile-menu-sheet {
    transition:
      transform 280ms cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-scrim,
    .mobile-menu-sheet {
      transition: none;
    }
  }
</style>

<script>
  import "../components/mobile-menu";
</script>