---
import ThemeToggle from "./ThemeToggle.astro";
import MobileMenu from "./MobileMenu.astro";

export interface Props {
  title?: string;
}

const { title } = Astro.props;
const pathname = Astro.url.pathname;

const links = [
  { href: "/", label: "Index" },
  { href: "/about", label: "About" },
  { href: "/blog", label: "Journal" },
  { href: "/components", label: "Components" },
  { href: "/playground", label: "Playground" },
];

function isActive(href: string): boolean {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="border-b border-border">
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-5 sm:px-8"
  >
    <a
      href="/"
      class="font-display text-xl font-medium tracking-tight text-foreground"
    >
      {title ?? "Astro Template"}
      <span class="ml-1 text-accent">.</span>
    </a>

    {/* Desktop nav — hidden < md */}
    <nav
      aria-label="Primary"
      class="hidden items-center gap-7 text-sm md:flex"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "transition-colors",
              isActive(link.href)
                ? "text-foreground"
                : "text-muted-foreground hover:text-foreground",
            ]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <MobileMenu />
    </div>
  </div>
</header>