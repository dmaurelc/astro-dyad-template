---
import "../styles/global.css";
import Head from "../components/Head.astro";

/**
 * Shared page shell.
 *
 * Owns structural concerns (<html>, <body>, skip link, theme pre-paint).
 * Forwards SEO concerns to <Head />, which wraps <Seo /> + JSON-LD.
 *
 * Pages can opt in to article metadata and per-page structured data via
 * the named `jsonld` slot:
 *
 *   <Layout title="…" type="article" …>
 *     <JsonLd slot="jsonld" data={buildArticleJsonLd(…)} />
 *     <article>…</article>
 *   </Layout>
 */

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  author?: string;
  tags?: string[];
  noindex?: boolean;
  breadcrumbs?: { name: string; href: string }[];
}

const {
  title = "Astro Template",
  description = "An editorial Astro template with Tailwind v4 and dark mode.",
  image,
  type,
  publishedTime,
  author,
  tags,
  noindex,
  breadcrumbs,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {/* Editorial typefaces — variable fonts for crisp display rendering */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300..700&family=Geist:wght@400..600&family=JetBrains+Mono:wght@400..500&display=swap"
    />

    {/* Pre-paint theme: prevents FOUC by setting .dark on <html> before stylesheet parses */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark =
            window.matchMedia &&
            window.matchMedia("(prefers-color-scheme: dark)").matches;
          var theme = stored ?? (prefersDark ? "dark" : "light");
          if (theme === "dark") document.documentElement.classList.add("dark");
        } catch (e) {}
      })();
    </script>

    <Head
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      author={author}
      tags={tags}
      noindex={noindex}
      breadcrumbs={breadcrumbs}
>
      <slot name="jsonld" slot="jsonld" />
    </Head>
  </head>
  <body class="min-h-[100dvh] bg-background text-foreground">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-foreground focus:px-3 focus:py-2 focus:text-sm focus:text-background"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>